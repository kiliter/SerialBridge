{
  "name": "serialbridge-alpha",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --experimental-test-isolation=none tests/*.test.mjs",
    "desktop:dev": "npm run build && cd crates/desktop && tauri dev",
    "desktop:build": "npm run build && cd crates/desktop && tauri build",
    "ui:serve": "python3 -m http.server 4173 --directory ui/dist",
    "extension:package": "npm run build && python scripts/package-extension.py"
  },
  "devDependencies": { "typescript": "5.8.3", "@tauri-apps/cli": "^2.0.0" },
  "engines": { "node": ">=22.8" }
}
